import docx
from docx.shared import Inches, Pt, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.enum.table import WD_TABLE_ALIGNMENT, WD_ALIGN_VERTICAL
from docx.oxml import OxmlElement, parse_xml
from docx.oxml.ns import nsdecls, qn

def create_delper_document_v2():
    doc = docx.Document()
    
    # Page setup
    for section in doc.sections:
        section.top_margin = Inches(1.0)
        section.bottom_margin = Inches(1.0)
        section.left_margin = Inches(1.0)
        section.right_margin = Inches(1.0)
        
    def set_cell_background(cell, color_hex):
        shading = parse_xml(f'<w:shd {nsdecls("w")} w:fill="{color_hex}"/>')
        cell._tc.get_or_add_tcPr().append(shading)
        
    def set_cell_margins(cell, top=140, bottom=140, left=180, right=180):
        tcPr = cell._tc.get_or_add_tcPr()
        tcMar = OxmlElement('w:tcMar')
        for m, val in [('w:top', top), ('w:bottom', bottom), ('w:left', left), ('w:right', right)]:
            node = OxmlElement(m)
            node.set(qn('w:w'), str(val))
            node.set(qn('w:type'), 'dxa')
            tcMar.append(node)
        tcPr.append(tcMar)

    def add_bottom_border(paragraph, color_hex="E2E8F0", size="12"):
        pPr = paragraph._p.get_or_add_pPr()
        pBdr = OxmlElement('w:pBdr')
        bottom = OxmlElement('w:bottom')
        bottom.set(qn('w:val'), 'single')
        bottom.set(qn('w:sz'), size)
        bottom.set(qn('w:space'), '4')
        bottom.set(qn('w:color'), color_hex)
        pBdr.append(bottom)
        pPr.append(pBdr)

    # Styles Setup
    styles = doc.styles
    normal_style = styles['Normal']
    normal_style.font.name = 'Arial'
    normal_style.font.size = Pt(10.5)
    normal_style.font.color.rgb = RGBColor(0x33, 0x41, 0x55)
    normal_style.paragraph_format.line_spacing = 1.25
    normal_style.paragraph_format.space_after = Pt(8)

    # DOCUMENT HEADER BLOCK
    header_table = doc.add_table(rows=1, cols=1)
    header_table.alignment = WD_TABLE_ALIGNMENT.CENTER
    header_cell = header_table.cell(0, 0)
    header_cell.width = Inches(6.5)
    set_cell_background(header_cell, "0F172A")
    set_cell_margins(header_cell, top=400, bottom=400, left=400, right=400)
    
    hp1 = header_cell.paragraphs
    hp1.paragraph_format.space_after = Pt(4)
    hr1 = hp1.add_run("EXECUTIVE SUMMARY: DELPER ECOM GLOBAL ECOSYSTEM")
    hr1.font.name = 'Arial'
    hr1.font.size = Pt(18)
    hr1.font.bold = True
    hr1.font.color.rgb = RGBColor(0xFF, 0xFF, 0xFF)
    
    hp2 = header_cell.add_paragraph()
    hp2.paragraph_format.space_after = Pt(0)
    hr2 = hp2.add_run("A Closed-Loop, Sovereign-Backed Civilizational Engine Bridging Digital Yields with Physical Smart Cities")
    hr2.font.name = 'Arial'
    hr2.font.size = Pt(11)
    hr2.font.color.rgb = RGBColor(0x94, 0xA3, 0xB8)
    
    doc.add_paragraph()

    def add_heading_1(text):
        p = doc.add_paragraph()
        p.paragraph_format.space_before = Pt(24)
        p.paragraph_format.space_after = Pt(8)
        p.paragraph_format.keep_with_next = True
        run = p.add_run(text)
        run.font.name = 'Arial'
        run.font.size = Pt(14)
        run.font.bold = True
        run.font.color.rgb = RGBColor(0x0F, 0x17, 0x2A)
        add_bottom_border(p, color_hex="CBD5E1", size="16")
        return p

    def add_heading_2(text):
        p = doc.add_paragraph()
        p.paragraph_format.space_before = Pt(14)
        p.paragraph_format.space_after = Pt(4)
        p.paragraph_format.keep_with_next = True
        run = p.add_run(text)
        run.font.name = 'Arial'
        run.font.size = Pt(11.5)
        run.font.bold = True
        run.font.color.rgb = RGBColor(0x25, 0x63, 0xEB)
        return p

    def add_bullet_item(bold_prefix, text):
        p = doc.add_paragraph(style='List Bullet')
        p.paragraph_format.space_after = Pt(4)
        p.paragraph_format.line_spacing = 1.15
        r1 = p.add_run(bold_prefix)
        r1.bold = True
        r1.font.color.rgb = RGBColor(0x1E, 0x29, 0x3B)
        p.add_run(text)
        return p

    def add_diagram_box(diagram_text):
        tbl = doc.add_table(rows=1, cols=1)
        tbl.alignment = WD_TABLE_ALIGNMENT.CENTER
        cell = tbl.cell(0,0)
        cell.width = Inches(6.5)
        set_cell_background(cell, "0F172A")
        set_cell_margins(cell, top=200, bottom=200, left=200, right=200)
        
        tcPr = cell._tc.get_or_add_tcPr()
        tcBorders = OxmlElement('w:tcBorders')
        left = OxmlElement('w:left')
        left.set(qn('w:val'), 'single')
        left.set(qn('w:sz'), '24')
        left.set(qn('w:color'), '2563EB')
        tcBorders.append(left)
        tcPr.append(tcBorders)
        
        p = cell.paragraphs
        p.paragraph_format.space_after = Pt(0)
        r = p.add_run(diagram_text)
        r.font.name = 'Consolas'
        r.font.size = Pt(8.5)
        r.font.color.rgb = RGBColor(0xE2, 0xE8, 0xF0)
        doc.add_paragraph()

    # SECTION 1
    add_heading_1("1. Strategic Vision & Value Proposition")
    add_heading_2("1.1 The Fundamental Macro Paradox")
    doc.add_paragraph("Modern digital economies generate trillions of dollars in value through human attention, data mediation, and programmatic advertising. However, these yields remain locked in hyper-volatile, speculative, or siloed digital structures. Conversely, real-world physical infrastructure—such as sustainable urban centers, food systems, and housing—faces extreme financing deficits, high debt costs, and slow deployment timelines.")
    
    add_heading_2("1.2 The Delper Solution")
    doc.add_paragraph("Delper Ecom Global resolves this structural fragmentation by building a parallel capital engine. This system converts verified, daily human attention into non-speculative physical goods and self-sustained smart cities. The platform does not rely on volatile external cash flows or retail speculative markets. Instead, it utilizes an automated, closed-loop economic model to transform programmatic ad revenue into real-world consumer staples, global B2B trade networks, and sovereign-backed infrastructure assets.")

    add_diagram_box(
        "+---------------------------+       Programmatic Ad Payouts       +---------------------------+\n"
        "|   DIGITAL REVENUE ENGINE  | ==================================> | LOCAL REDEMPTION REWARDS  |\n"
        "| - Verified User Attention |                                     | - 100% Cashless Staples   |\n"
        "| - Ad Mediation Arbitrage  | <================================== | - Continuous Local Demand |\n"
        "+---------------------------+       Data & Engagement Feed        +---------------------------+\n"
        "              ||                                                                ||\n"
        "              || Tokenized Reserve Escrow                                       || Local B2B SBLC Flows\n"
        "              v                                                                 v\n"
        "+---------------------------+                                     +---------------------------+\n"
        "|    CAPITAL TRUST ENGINE   | ==================================> | REAL-WORLD INFRASTRUCTURE |\n"
        "| - 1.50T Institutional Cap |       3-Year Cash-Backed SBLCs      | - 9,000-Acre Bidadi City  |\n"
        "| - Singapore Escrow Vault  |                                     | - 2,500 Self-Sustained Cts|\n"
        "+---------------------------+                                     +---------------------------+"
    )

    # SECTION 2
    add_heading_1("2. Structural Tri-Tier Corporate Architecture")
    doc.add_paragraph("To ensure high tax efficiency, protect intellectual property, and secure global regulatory standing, the ecosystem operates through a coordinated, multi-tiered corporate structure:")

    add_diagram_box(
        "                      +-----------------------------------------------+\n"
        "                      |           SINGAPORE HOLDING COMPANY           |\n"
        "                      |        Delper Global Holdings Pte. Ltd.       |\n"
        "                      | - Capital Base: USD 1T  | 10T Capital Shares  |\n"
        "                      | - Seed Capital: USD 2.07B (GK Bharta Anchor)  |\n"
        "                      | - Master IP Vault & Global Custodial Treasury |\n"
        "                      +-----------------------------------------------+\n"
        "                                              |\n"
        "                +-----------------------------+-----------------------------+\n"
        "                |                                                           |\n"
        "                v                                                           v\n"
        "+-----------------------------------------------+           +-----------------------------------------------+\n"
        "|             DUBAI REGIONAL ENGINE             |           |             INDIA OPERATIONAL HUB             |\n"
        "|        Delper Ecom Global Portal FZCO         |           |          Delper Ecom Private Limited          |\n"
        "| - B2B Trade Settlement & Ledger Clearing     |           | - Corporate HQ: Bengaluru, Karnataka          |\n"
        "| - Onboarding Gate: 19M Global Product Vendors |           | - Master Site: 9,000-Acre Bidadi Town Grid    |\n"
        "| - Token Velocity Curation & Gas Matrix Nodes  |           | - OEM Supply Contracts & Local Logistics Hubs |\n"
        "+-----------------------------------------------+           +-----------------------------------------------+"
    )

    add_heading_2("2.1 Parent Vehicle: Delper Global Holdings Pte. Ltd. (Singapore)")
    add_bullet_item("Corporate Framework: ", "Incorporated under the Singapore Companies Act (Chapter 50) to leverage the state’s triple-A credit rating and established financial legal structures.")
